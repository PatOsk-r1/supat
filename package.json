{
  "name": "supat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:red": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\"",
    "test:reglas": "firebase emulators:exec --only firestore --project demo-supat \"node --test tests/reglas.emu.js\"",
    "dev:emu": "vite --mode emulador",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-supat",
    "emuladores:alt": "firebase emulators:start --only auth,firestore --project demo-supat --config firebase.emu-alt.json",
    "api:dev": "wrangler dev --config worker/wrangler.toml --env local --port 8788 --ip 127.0.0.1 --test-scheduled",
    "api:migrar:local": "wrangler d1 migrations apply supat-catalogo --local --config worker/wrangler.toml --env local",
    "api:real:migrar": "wrangler d1 migrations apply supat-catalogo --local --config worker/wrangler.toml --env local --persist-to worker/.wrangler/real",
    "api:real": "wrangler dev --config worker/wrangler.toml --env local --port 8788 --ip 127.0.0.1 --test-scheduled --persist-to worker/.wrangler/real",
    "cuenta:local": "node scripts/cuenta-local.mjs",
    "test:integracion": "node --test tests/integracion-real.test.js",
    "api:migrar": "wrangler d1 migrations apply supat-catalogo --remote --config worker/wrangler.toml",
    "api:publicar": "wrangler deploy --config worker/wrangler.toml --env=\"\"",
    "api:clave": "node scripts/clave-secretos.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "hls.js": "^1.7.4",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "wrangler": "^4.157.0"
  }
}
